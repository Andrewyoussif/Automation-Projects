<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Suite" parallel="tests" thread-count="3">
    <listeners>
        <listener class-name="utils.RetryListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="login.LoginTests"/>
        </classes>
    </test>

    <test name="PIM Tests">
        <classes>
            <class name="pim.EmployeeSearchTests"/>
            <class name="pim.AddEmployeeTests"/>
        </classes>
    </test>

    <test name="Admin and UI Tests">
        <classes>
            <class name="admin.AddUserTests"/>
            <class name="ui.UiTests"/>
        </classes>
    </test>
</suite>
